# [보안 설정]
SECRET_KEY="your_super_secret_jwt_key_here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# [데이터베이스 경로]
DATABASE_URL="sqlite:///./data/chatbot.db"

# [코디세이 AI API 설정 (500만 토큰 제공)]
CODESSEY_API_KEY="your_codessey_api_key"
CODESSEY_API_BASE="https://api.openai.com/v1"
AI_MODEL_NAME="gpt-4o-mini"
AI_TIMEOUT_SECONDS=8.0

# 아래 값들은 독립 구현의 추가 설정이며 기존 팀 키를 대체하지 않습니다.
# 위 예시 비밀값과 API 키는 실제 환경에서 반드시 교체해야 합니다.
APP_ENV=development
AI_MODE=auto
CONTEXT_TURNS=5
